page {
  --lf-forest: #173f35;
  --lf-sage: #dfece6;
  --lf-coral: #e9684a;
  --lf-amber: #d9892b;
  --lf-blue: #4b8da6;
  --lf-ink: #1e2a27;
  --lf-muted: #697a76;
  --lf-border: #d9e5e1;
  --lf-surface: #fbfefd;
  --lf-page: #eef4f6;
  --button-primary-background-color: #173f35;
  --button-primary-border-color: #173f35;
  --button-danger-background-color: #c2412d;
  --button-danger-border-color: #c2412d;
  --button-border-radius: 8rpx;
  --cell-border-color: #edf2f0;
  --cell-group-background-color: #fbfefd;
  --cell-group-inset-border-radius: 8rpx;
  --cell-text-color: #1e2a27;
  --field-input-text-color: #1e2a27;
  --field-label-color: #526561;
  --tag-primary-color: #2f6f5e;
  --tag-warning-color: #d9892b;
  --tag-danger-color: #c2412d;
  --grid-item-content-background-color: #fbfefd;
  min-height: 100%;
  background: #eef4f6;
  color: #1e2a27;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view,
text,
input,
textarea,
picker,
button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    linear-gradient(180deg, rgba(223, 236, 230, 0.58) 0%, rgba(238, 244, 246, 0) 260rpx),
    #eef4f6;
}

.page-header {
  margin: 12rpx 0 28rpx;
}

.eyebrow {
  color: #e9684a;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #173f35;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #697a76;
  line-height: 1.5;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #fbfefd;
  border: 1rpx solid #d9e5e1;
  border-radius: 8rpx;
  box-shadow: 0 14rpx 34rpx rgba(23, 63, 53, 0.08);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.muted {
  color: #697a76;
}

.small {
  font-size: 24rpx;
}

.money {
  color: #e9684a;
  font-weight: 700;
}

.badge {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  color: #173f35;
  background: #dfece6;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.badge.warn {
  color: #8a520f;
  background: #fff0d3;
}

.badge.danger {
  color: #c2412d;
  background: #ffe4dc;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #526561;
  font-size: 24rpx;
}

.input,
.textarea,
.picker {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  background: #fbfefd;
  border: 1rpx solid #d2dfdb;
  border-radius: 8rpx;
}

.textarea {
  min-height: 160rpx;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  padding: 0 28rpx;
  color: #ffffff;
  background: #173f35;
  border-radius: 8rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.button.secondary {
  color: #173f35;
  background: #dfece6;
}

.button.ghost {
  color: #526561;
  background: #fbfefd;
  border: 1rpx solid #d2dfdb;
}

.button.danger {
  background: #c2412d;
}

.button-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.empty {
  padding: 72rpx 28rpx;
  color: #697a76;
  text-align: center;
}

.van-card-shell {
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #fbfefd;
  border: 1rpx solid #d9e5e1;
  border-radius: 8rpx;
  box-shadow: 0 14rpx 34rpx rgba(23, 63, 53, 0.08);
}

.form-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #fbfefd;
  border: 1rpx solid #d9e5e1;
  border-radius: 8rpx;
  box-shadow: 0 10rpx 26rpx rgba(23, 63, 53, 0.06);
}

.form-actions {
  display: grid;
  gap: 18rpx;
  padding: 24rpx;
  background: #fbfefd;
}

.status-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  color: #173f35;
  background: #e7f1ed;
  border: 1rpx solid #c7ddd4;
  border-radius: 8rpx;
}

.error-banner {
  color: #8a3528;
  background: #fff0ec;
  border-color: #f1c4ba;
}

.status-banner-title,
.status-banner-copy,
.upload-title,
.upload-copy {
  display: block;
}

.status-banner-title,
.upload-title {
  font-weight: 700;
}

.status-banner-copy,
.upload-copy {
  margin-top: 6rpx;
  color: #526561;
  font-size: 23rpx;
  line-height: 1.5;
}

.error-banner .status-banner-copy {
  color: #9a4739;
}

.status-banner-action {
  flex: 0 0 auto;
  padding: 10rpx 0 10rpx 18rpx;
  color: #2f6f5e;
  font-size: 26rpx;
  font-weight: 700;
}

.error-banner .status-banner-action {
  color: #c2412d;
}

.upload-panel {
  margin: 24rpx;
  padding: 20rpx;
  background: #f5faf8;
  border: 1rpx solid #d9e5e1;
  border-radius: 8rpx;
}

.photo-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.loading-state {
  display: flex;
  justify-content: center;
  margin: 48rpx 0;
}
