{
  "name": "laborflow-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "bun run dev:weapp",
    "dev:weapp": "NODE_ENV=development VITE_PLUGIN_TARO_TARGET=wx vite",
    "dev:h5": "NODE_ENV=development VITE_PLUGIN_TARO_TARGET=h5 vite",
    "typecheck": "tsc -b",
    "build": "bun run build:weapp",
    "build:weapp": "NODE_ENV=production VITE_PLUGIN_TARO_TARGET=wx vite build",
    "build:h5": "NODE_ENV=production VITE_PLUGIN_TARO_TARGET=h5 vite build",
    "preview:h5": "NODE_ENV=production VITE_PLUGIN_TARO_TARGET=h5 vite preview --outDir dist/h5",
    "check": "bun run typecheck && bun run build:weapp"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild"
  ],
  "dependencies": {
    "@taroify/core": "^1.0.5",
    "@taroify/icons": "1.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "rolldown": "1.2.3",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vite-plugin-taro": "^0.5.13",
    "weapp-tailwindcss": "^5.2.14"
  }
}
