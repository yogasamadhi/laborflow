{
  "name": "laborflow-desktop",
  "productName": "LaborFlow",
  "version": "0.1.0",
  "description": "LaborFlow 建筑劳务运营管理桌面端",
  "author": "LaborFlow",
  "private": true,
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "electron-forge start",
    "dev:renderer": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "build:renderer": "tsc -b && vite build --config vite.config.ts",
    "package": "electron-forge package",
    "build": "electron-forge make",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.0",
    "@vitejs/plugin-react": "^4.5.0",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "echarts": "^5.6.0",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "^22.15.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "electron": "43.4.0",
    "lodash": "^4.17.21",
    "prettier": "^3.9.5",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
