SPRING_PROFILES_ACTIVE=dev
POSTGRES_DB=laborflow
POSTGRES_USER=laborflow
POSTGRES_PASSWORD=laborflow123
DATABASE_URL=jdbc:postgresql://localhost:5434/laborflow
SERVER_PORT=8089
# Production must provide a random secret and must not use this example value.
JWT_SECRET=change-this-dev-secret-to-at-least-32-characters
# Only use for one startup when the database has no active ADMIN user. Do not commit real values.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Configure in the deploy environment; never commit the real app secret.
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
# Development defaults to local storage; production must set FILE_STORAGE_TYPE=object.
UPLOAD_DIR=./uploads
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_BASE_DIR=./uploads
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_AUTH_HEADER_NAME=Authorization
OBJECT_STORAGE_AUTH_HEADER_VALUE=
