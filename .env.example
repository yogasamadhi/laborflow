# LaborFlow development environment template.
#
# This file is tracked in git and ONLY contains placeholder/example values.
# `run.py` copies it to .env on first run and overwrites the POSTGRES_PASSWORD
# and JWT_SECRET lines with freshly generated random dev secrets, so a fresh
# clone never starts with the committed weak values.
#
# Production must set every variable explicitly (never copy this file verbatim).

SPRING_PROFILES_ACTIVE=dev
POSTGRES_DB=laborflow
POSTGRES_USER=laborflow
# Placeholder only — run.py replaces it with a random dev secret. Never use this value.
POSTGRES_PASSWORD=laborflow123
DATABASE_URL=jdbc:postgresql://localhost:5434/laborflow
SERVER_PORT=8089
# Production must provide a random secret of at least 32 bytes and must not use this example value.
JWT_SECRET=change-this-dev-secret-to-at-least-32-characters
# Only use for one startup when the database has no active ADMIN user. Do not commit real values.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Configure in the deploy environment; never commit the real app secret.
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_MINIAPP_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
# Development defaults to local storage; production must set FILE_STORAGE_TYPE=object.
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_BYTES=10485760
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_BASE_DIR=./uploads
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_AUTH_HEADER_NAME=Authorization
OBJECT_STORAGE_AUTH_HEADER_VALUE=
# Set to true to expose OpenAPI/Swagger UI in production (default false).
OPENAPI_ENABLED=false
# Optional: override log level for com.company.labor (default INFO).
LABORFLOW_LOG_LEVEL=INFO
# Optional: pin date serialization + JVM timezone (default Asia/Shanghai).
# Must match across server instances; see docs/TIMEZONE_POLICY.md.
LABORFLOW_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai
