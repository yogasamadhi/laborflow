SPRING_PROFILES_ACTIVE=dev
POSTGRES_DB=laborflow
POSTGRES_USER=laborflow
POSTGRES_PASSWORD=laborflow123
DATABASE_URL=jdbc:postgresql://localhost:5434/laborflow
SERVER_PORT=8089
# Production must provide a random secret and must not use this example value.
JWT_SECRET=change-this-dev-secret-to-at-least-32-characters
# Configure in the deploy environment; never commit the real app secret.
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
# Production should use an absolute persistent path or an object-storage mount.
UPLOAD_DIR=./uploads
