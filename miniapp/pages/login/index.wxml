<view class="login-page">
  <view class="brand">
    <text class="brand-mark">LF</text>
    <text class="title">LaborFlow</text>
    <text class="subtitle">现场填报、工资查看、移动审批</text>
  </view>

  <view class="card">
    <van-field value="{{username}}" data-key="username" bind:change="onInput" label="账号" placeholder="请输入账号" left-icon="manager-o" clearable />
    <van-field value="{{password}}" data-key="password" bind:change="onInput" label="密码" type="password" placeholder="请输入密码" left-icon="lock" clearable />
    <view class="login-actions">
      <van-button block plain type="primary" icon="wechat" bind:tap="chooseProfile">
        {{authButtonText}}
      </van-button>
      <van-button block type="primary" loading="{{loading}}" icon="passed" bind:tap="submit">登录并绑定账号</van-button>
    </view>
  </view>
</view>
