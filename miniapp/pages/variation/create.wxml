<view class="page">
  <view class="page-header">
    <text class="eyebrow">签证变更</text>
    <text class="title">{{pageTitle}}</text>
    <text class="subtitle">填写过程会暂存到本机，网络恢复后可继续提交。</text>
  </view>

  <view wx:if="{{draftRestored}}" class="status-banner">
    <view>
      <text class="status-banner-title">已恢复未完成草稿</text>
      <text class="status-banner-copy">可继续编辑、保存到服务器或清空后重新填写。</text>
    </view>
    <text class="status-banner-action" bind:tap="discardLocalDraft">清空</text>
  </view>

  <view class="form-card">
    <van-cell-group border="{{false}}">
      <picker mode="date" value="{{form.occurrenceDate}}" bindchange="onDateChange">
        <van-cell title="发生日期" value="{{form.occurrenceDate}}" icon="calendar-o" is-link />
      </picker>
      <picker range="{{projectNames}}" disabled="{{lookupLoading}}" bindchange="onProjectChange">
        <van-cell title="项目" value="{{projectText}}" icon="hotel-o" is-link />
      </picker>
      <picker range="{{sectionNames}}" disabled="{{lookupLoading || !form.projectId}}" bindchange="onSectionChange">
        <van-cell title="发生位置" value="{{sectionText}}" icon="location-o" is-link />
      </picker>
      <picker range="{{typeNames}}" bindchange="onTypeChange">
        <van-cell title="签证类型" value="{{variationTypeText}}" icon="todo-list-o" is-link />
      </picker>
      <van-field value="{{form.reason}}" data-key="reason" bind:change="onInput" label="发生原因" type="textarea" autosize placeholder="请输入可追溯的发生原因" />
      <van-field value="{{form.responsibleParty}}" data-key="responsibleParty" bind:change="onInput" label="责任方" placeholder="请输入" />
      <van-field value="{{form.increasedQuantity}}" data-key="increasedQuantity" bind:change="onInput" label="工程量" type="digit" placeholder="请输入大于 0 的数值" />
      <van-field value="{{form.estimatedAmount}}" data-key="estimatedAmount" bind:change="onInput" label="估算金额" type="digit" placeholder="可留空" />
      <van-field value="{{form.laborCount}}" data-key="laborCount" bind:change="onInput" label="人工说明" type="number" placeholder="人工数量" />
      <van-field value="{{form.machineryShift}}" data-key="machineryShift" bind:change="onInput" label="机械说明" placeholder="请输入" />
      <van-field value="{{form.materialNote}}" data-key="materialNote" bind:change="onInput" label="材料说明" type="textarea" autosize placeholder="请输入" />
    </van-cell-group>

    <view class="upload-panel">
      <view class="row">
        <view>
          <text class="upload-title">现场照片（{{photoCount}}）</text>
          <text class="upload-copy">{{uploadText}}</text>
        </view>
        <van-button size="small" plain type="primary" icon="photograph" loading="{{uploading}}" disabled="{{saving || submitting || uploading}}" bind:tap="uploadPhotos">添加</van-button>
      </view>
      <view wx:if="{{uploadedFiles.length}}" class="photo-tags">
        <van-tag wx:for="{{uploadedFiles}}" wx:key="id" closeable plain type="primary" data-index="{{index}}" bind:close="removePhoto">照片 {{index + 1}}</van-tag>
      </view>
    </view>

    <view class="form-actions">
      <van-button block plain type="primary" icon="bookmark-o" disabled="{{saving || submitting || uploading}}" bind:tap="saveLocalDraft">暂存到本机</van-button>
      <van-button block plain type="primary" loading="{{saving}}" disabled="{{saving || submitting || uploading}}" icon="description" bind:tap="saveDraft">保存草稿</van-button>
      <van-button block type="primary" loading="{{submitting}}" disabled="{{saving || submitting || uploading}}" icon="success" bind:tap="submit">提交签证</van-button>
    </view>
  </view>
</view>
