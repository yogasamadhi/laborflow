<view class="page">
  <view class="page-header">
    <text class="eyebrow">工程量日报</text>
    <text class="title">{{pageTitle}}</text>
    <text class="subtitle">填写过程会暂存到本机，网络恢复后可继续提交。</text>
  </view>

  <view wx:if="{{draftRestored}}" class="status-banner">
    <view>
      <text class="status-banner-title">已恢复未完成草稿</text>
      <text class="status-banner-copy">可继续编辑、保存到服务器或清空后重新填写。</text>
    </view>
    <text class="status-banner-action" bind:tap="discardLocalDraft">清空</text>
  </view>

  <view class="form-card">
    <van-cell-group border="{{false}}">
      <picker mode="date" value="{{form.workDate}}" bindchange="onDateChange">
        <van-cell title="日期" value="{{form.workDate}}" icon="calendar-o" is-link />
      </picker>
      <picker range="{{projectNames}}" disabled="{{lookupLoading}}" bindchange="onProjectChange">
        <van-cell title="项目" value="{{projectText}}" icon="hotel-o" is-link />
      </picker>
      <picker range="{{sectionNames}}" disabled="{{lookupLoading || sectionsLoading || !form.projectId}}" bindchange="onSectionChange">
        <van-cell title="施工段" value="{{sectionText}}" icon="location-o" is-link />
      </picker>
      <picker range="{{processNames}}" disabled="{{lookupLoading}}" bindchange="onProcessChange">
        <van-cell title="工序" value="{{processText}}" icon="apps-o" is-link />
      </picker>
      <picker range="{{teamNames}}" disabled="{{lookupLoading}}" bindchange="onTeamChange">
        <van-cell title="班组" value="{{teamText}}" icon="friends-o" is-link />
      </picker>
      <van-field value="{{form.completedQuantity}}" data-key="completedQuantity" bind:change="onInput" label="完成工程量" type="digit" placeholder="请输入大于 0 的数值" />
      <van-field value="{{form.unit}}" data-key="unit" bind:change="onInput" label="单位" placeholder="m / m³ / 项" />
      <van-field value="{{form.workerCount}}" data-key="workerCount" bind:change="onInput" label="施工人数" type="number" placeholder="请输入大于 0 的人数" />
      <van-field value="{{form.machineryUsage}}" data-key="machineryUsage" bind:change="onInput" label="机械使用" placeholder="如挖机 1 台班" />
      <van-field value="{{form.exceptionNote}}" data-key="exceptionNote" bind:change="onInput" label="异常说明" type="textarea" autosize placeholder="无异常可留空" />
      <van-field value="{{form.reporterName}}" data-key="reporterName" bind:change="onInput" label="填报人" placeholder="请输入" />
    </van-cell-group>

    <view class="upload-panel">
      <view class="row">
        <view>
          <text class="upload-title">现场照片（{{photoCount}}）</text>
          <text class="upload-copy">{{uploadText}}</text>
        </view>
        <van-button size="small" plain type="primary" icon="photograph" loading="{{uploading}}" disabled="{{saving || submitting || uploading}}" bind:tap="uploadPhotos">添加</van-button>
      </view>
      <view wx:if="{{uploadedFiles.length}}" class="photo-tags">
        <van-tag wx:for="{{uploadedFiles}}" wx:key="id" closeable plain type="primary" data-index="{{index}}" bind:close="removePhoto">照片 {{index + 1}}</van-tag>
      </view>
    </view>

    <view class="form-actions">
      <van-button block plain type="primary" icon="bookmark-o" disabled="{{saving || submitting || uploading}}" bind:tap="saveLocalDraft">暂存到本机</van-button>
      <van-button block plain type="primary" loading="{{saving}}" disabled="{{saving || submitting || uploading}}" icon="description" bind:tap="saveDraft">保存草稿</van-button>
      <van-button block type="primary" loading="{{submitting}}" disabled="{{saving || submitting || uploading}}" icon="success" bind:tap="submit">提交日报</van-button>
    </view>
  </view>
</view>
