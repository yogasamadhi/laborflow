.identity-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.field-card {
  background:
    radial-gradient(circle at 90% 2%, rgba(75, 141, 166, 0.18) 0, rgba(75, 141, 166, 0) 160rpx),
    #fbfefd;
}

.field-title {
  display: block;
  margin-top: 8rpx;
  color: #173f35;
  font-size: 40rpx;
  font-weight: 800;
}

.field-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf2f0;
}

.field-metrics view {
  display: grid;
  gap: 6rpx;
}

.metric-value {
  color: #e9684a;
  font-size: 42rpx;
  font-weight: 800;
}

.salary-card {
  background:
    radial-gradient(circle at 92% 10%, rgba(233, 104, 74, 0.78) 0, rgba(233, 104, 74, 0) 145rpx),
    linear-gradient(135deg, #173f35 0%, #2f6f5e 58%, #4b8da6 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 18rpx 42rpx rgba(23, 63, 53, 0.24);
}

.salary-card .muted {
  color: rgba(255, 255, 255, 0.78);
}

.amount {
  display: block;
  margin: 12rpx 0;
  font-size: 56rpx;
  font-weight: 800;
}

.action-shell {
  padding: 10rpx 0;
  border-color: #d9e5e1;
}

.action-title,
.section-title {
  display: block;
  font-weight: 700;
}

.todo-row,
.project-row {
  padding: 24rpx 0 0;
  border-top: 1rpx solid #edf2f0;
}

.todo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
