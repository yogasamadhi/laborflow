<view class="page">
  <view class="page-header">
    <text class="eyebrow">{{month}}</text>
    <text class="title">工资条明细</text>
    <text class="subtitle">确认后无法重复提交，请先核对明细与金额。</text>
  </view>

  <view wx:if="{{loadError}}" class="status-banner error-banner">
    <view>
      <text class="status-banner-title">工资条暂时无法加载</text>
      <text class="status-banner-copy">{{loadError}}</text>
    </view>
    <text class="status-banner-action" bind:tap="load">重试</text>
  </view>

  <view wx:if="{{loading && !hasLoaded}}" class="loading-state">
    <van-loading size="42rpx" vertical>正在加载工资条</van-loading>
  </view>

  <van-empty wx:if="{{hasLoaded && !loading && !detail && !loadError}}" image="search" description="未找到工资条" />

  <view class="card" wx:if="{{detail}}">
    <view class="row">
      <text class="muted">发放状态</text>
      <van-tag plain type="{{detail.paymentStatusTagType}}">{{detail.paymentStatusText}}</van-tag>
    </view>
    <view class="row payslip-status-row">
      <text class="muted">工资条确认</text>
      <van-tag plain type="{{detail.payslipStatusTagType}}">{{detail.payslipStatusText}}</van-tag>
    </view>
    <view class="money-line">
      <text class="muted small">实发金额</text>
      <text class="actual">{{detail.actualAmountText}}</text>
    </view>
    <view class="split">
      <view>
        <text class="muted small">应发</text>
        <text>{{detail.payableAmountText}}</text>
      </view>
      <view>
        <text class="muted small">扣减</text>
        <text>{{detail.deductionAmountText}}</text>
      </view>
      <view>
        <text class="muted small">发放日期</text>
        <text>{{detail.paymentDateText}}</text>
      </view>
    </view>
    <view class="payslip-action">
      <text class="payslip-note">{{payslipNotice}}</text>
      <view wx:if="{{canConfirmPayslip}}" class="button-row">
        <van-button block plain type="danger" disabled="{{confirming}}" bind:tap="openFeedback">提出异议</van-button>
        <van-button block type="primary" loading="{{confirming}}" disabled="{{confirming}}" bind:tap="confirmPayslip">确认无误</van-button>
      </view>
      <view wx:if="{{feedbackOpen}}" class="action-panel">
        <van-field value="{{feedback}}" bind:change="onFeedback" label="异议说明" type="textarea" autosize required placeholder="请说明需核对的工资项目或金额" />
        <view class="button-row">
          <van-button block plain disabled="{{confirming}}" bind:tap="cancelFeedback">取消</van-button>
          <van-button block type="danger" loading="{{confirming}}" disabled="{{confirming}}" bind:tap="submitFeedback">提交异议</van-button>
        </view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{detail}}">
    <text class="section-title">工资项目</text>
    <van-empty wx:if="{{items.length === 0}}" image="search" description="暂无明细项" />
    <view wx:for="{{items}}" wx:key="id" class="item-row">
      <view>
        <text>{{item.salaryItemName}}</text>
        <van-tag plain type="{{item.tagType}}">{{item.typeText}}</van-tag>
      </view>
      <text class="{{item.amountClass}}">{{item.amountText}}</text>
    </view>
  </view>
</view>
