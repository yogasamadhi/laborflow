<view class="page">
  <view class="page-header">
    <text class="eyebrow">{{employeeNameText}}</text>
    <text class="title">我的工资</text>
    <text class="subtitle">金额、发放状态和工资条确认状态均以当前记录为准。</text>
  </view>

  <view wx:if="{{!unbound}}" class="card summary">
    <view>
      <text class="muted small">累计实发</text>
      <text class="summary-money">{{totalActualText}}</text>
    </view>
    <view class="summary-side">
      <text class="muted small">记录</text>
      <text class="summary-count">{{records.length}}</text>
    </view>
  </view>

  <view wx:if="{{loadError}}" class="status-banner error-banner">
    <view>
      <text class="status-banner-title">工资记录暂时无法加载</text>
      <text class="status-banner-copy">{{loadError}}</text>
    </view>
    <text class="status-banner-action" bind:tap="load">重试</text>
  </view>

  <view wx:if="{{loading && !hasLoaded}}" class="loading-state">
    <van-loading size="42rpx" vertical>正在加载工资记录</van-loading>
  </view>

  <van-empty wx:if="{{unbound}}" image="error" description="当前账号未绑定员工，无法查看工资" />
  <van-empty wx:elif="{{hasLoaded && !loading && records.length === 0 && !loadError}}" image="search" description="暂无工资记录" />

  <view wx:for="{{records}}" wx:key="detailId" class="card salary-row" data-item="{{item}}" bindtap="openDetail">
    <view class="row">
      <view>
        <text class="row-title">{{item.salaryMonth}}</text>
        <text class="muted small">{{item.paymentDateText}}</text>
      </view>
      <view class="right">
        <text class="money">{{item.actualAmountText}}</text>
        <van-tag plain type="{{item.statusTagType}}">{{item.statusText}}</van-tag>
      </view>
    </view>
    <van-divider />
    <view class="salary-status-row">
      <text class="muted small">{{item.payslipStatusText}}</text>
      <van-tag plain type="{{item.payslipStatusTagType}}">工资条</van-tag>
    </view>
    <van-grid column-num="2" border="{{false}}">
      <van-grid-item icon="gold-coin-o" text="应发 {{item.payableAmountText}}" />
      <van-grid-item icon="refund-o" text="扣减 {{item.deductionAmountText}}" />
    </van-grid>
  </view>
</view>
