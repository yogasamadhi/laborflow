.idea/
.vscode/
*.iml
.classpath
.project
.settings/

# Environment files
.env
.env.*
!.env.example
!**/.env.example

# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/

# Node / frontend build output
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python local files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Java / Maven local files
target/
*.class
.m2/
hs_err_pid*
replay_pid*

# WeChat mini program local/build files
miniapp/project.private.config.json
miniapp/miniprogram_npm/
miniapp/*.wxapkg
# Machine/release-specific miniapp env override (see config/env.local.example.js)
miniapp/config/env.local.js

# Runtime data
uploads/
docker-data/
tmp/
temp/
