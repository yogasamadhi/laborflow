<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Default console appender. Levels are tuned per-profile below. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Development / test: verbose, help debugging. -->
    <springProfile name="dev,test,default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.company.labor" level="DEBUG"/>
    </springProfile>

    <!-- Production: INFO by default, app code respects LABORFLOW_LOG_LEVEL. -->
    <springProfile name="prod,production">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.company.labor" level="${LABORFLOW_LOG_LEVEL:-INFO}"/>
        <!-- Quiet down noisy framework loggers in prod. -->
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>
    </springProfile>
</configuration>
